                `${backendUrl}/users/${userId}/visibility`,
                {
                    userId: userId,
                    visibility: visibilitySettings[userId],
                    type: "oneOnOne"
                },
                {
                    headers: {
                        Authorization: `Bearer ${session?.user?.token}`,
                    },
                }
            );
