  type: string;
  fileUrl: string;
  publicId: string;
  fileName: string;
  fileSize: number;
  mimeType: string;
  uploadedById: string;
  employeeId: string | null;
  tenantId: string;
  createdAt: string;
  updatedAt: string;
  uploadedBy: { id: string; name: string; email: string; avatar?: string };
